# ── Supabase Database & Auth ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Cloudflare R2 Object Storage ──────────────────────────────────────
# Dapatkan dari Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=thi-qhsse-documents

# URL Akses Publik / Custom Domain R2 (Opsional, dari R2 Bucket Settings -> Public Access / r2.dev)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-id.r2.dev

# ── Corporate Email Notification (Distribusi Dokumen) ──────────────────
# Opsi 1: Server Mail / SMTP Perusahaan (misal: mail.thi.co.id / Office 365)
SMTP_HOST=mail.thi.co.id
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=qhsse@thi.co.id
SMTP_PASS=password-email-perusahaan-anda
SMTP_FROM="PT Taka Hydrocore Indonesia (DMS)" <qhsse@thi.co.id>

# Opsi 2: Resend API dengan Custom Domain (@thi.co.id)
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM=qhsse@thi.co.id

